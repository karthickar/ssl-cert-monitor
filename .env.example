# Database: SQLite is the default. DATABASE_URL, if set, overrides all settings below.
DATABASE_ENGINE=sqlite
SQLITE_DATABASE_PATH=/app/data/ssl_monitor.db
# To use local MySQL with mysql-connector, uncomment and set:
# DATABASE_ENGINE=mysql
# MYSQL_HOST=host.docker.internal
# MYSQL_PORT=3306
# MYSQL_DATABASE=ssl_monitor
# MYSQL_USERNAME=ssl_monitor
# MYSQL_PASSWORD=change-me
# DATABASE_URL=mysql+mysqlconnector://user:password@hostname:3306/ssl_monitor
DEFAULT_EXPIRY_THRESHOLD_DAYS=7
CHECK_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
# Optional fallback webhook. Per-service configuration takes precedence.
DEFAULT_WEBHOOK_URL=
# SMTP is only needed when using email recipients. Keep secrets in .env, never in the dashboard.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@example.com
SMTP_USE_TLS=true
# Daily certificate refresh and Google sign-in.
CHECK_INTERVAL_HOURS=24
SESSION_SECRET_KEY=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/google/callback
# Local-only Gmail-style login for development. Leave false in production.
AUTH_ALLOW_DEV_LOGIN=false
DISABLE_SCHEDULER=false
